@model YourPetHealth.Models.Responsavel

@{
    ViewData["Title"] = "Confirmar Exclusão - Responsável";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg">
                <div class="card-header bg-danger text-black py-3">
                    <h4 class="mb-0 text-center">
                        <i class="fas fa-trash-alt"></i> Confirmar Exclusão
                    </h4>
                </div>
                
                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Atenção:</strong> Esta ação não pode ser desfeita!
                    </div>

                    <h5 class="mb-3">Dados do Responsável:</h5>
                    
                    <dl class="row">
                        <dt class="col-sm-3 fw-bold">Nome:</dt>
                        <dd class="col-sm-9">@Model.Nome</dd>
                        <dt class="col-sm-3 fw-bold">Email:</dt>
                        <dd class="col-sm-9">@Model.Email</dd>
                        <dt class="col-sm-3 fw-bold">Telefone:</dt>
                        <dd class="col-sm-9">@Model.Telefone</dd>
                    </dl>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between p-4">
                    <a asp-action="Index" class="btn btn-secondary px-5">Cancelar</a>
                    
                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger px-5">
                            <i class="fas fa-trash"></i> Sim, Excluir
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>