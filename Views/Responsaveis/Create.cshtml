@model YourPetHealth.Models.Responsavel
@{
    ViewData["Title"] = "Novo Responsável";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-black">
                <h4><i class="fas fa-user-plus"></i> Cadastrar Novo Responsável</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label">Nome Completo</label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <input asp-for="Senha" type="password" class="form-control" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefone</label>
                        <input asp-for="Telefone" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-success btn-lg">Cadastrar Responsável</button>
                    <a asp-action="Index" class="btn btn-secondary btn-lg">Voltar</a>
                </form>
            </div>
        </div>
    </div>
</div> 