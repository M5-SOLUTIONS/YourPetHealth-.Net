@{
    ViewData["Title"] = "Dashboard - YourPetHealth";
}

<div class="container">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 fw-bold text-primary">
                🐾 Bem-vindo ao YourPetHealth
            </h1>
            <p class="lead text-muted">Central de Gestão da Saúde Animal</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm pet-card">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x text-primary mb-3"></i>
                    <h3 class="card-title">@ViewBag.TotalResponsaveis</h3>
                    <p class="text-muted">Responsáveis Cadastrados</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm pet-card">
                <div class="card-body text-center">
                    <i class="fas fa-user-md fa-3x text-success mb-3"></i>
                    <h3 class="card-title">@ViewBag.TotalVeterinarios</h3>
                    <p class="text-muted">Veterinários</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm pet-card">
                <div class="card-body text-center">
                    <i class="fas fa-paw fa-3x text-warning mb-3"></i>
                    <h3 class="card-title">@ViewBag.TotalPets</h3>
                    <p class="text-muted">Pets Cadastrados</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card h-100 border-0 shadow-sm pet-card">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-check fa-3x text-info mb-3"></i>
                    <h3 class="card-title">@ViewBag.TotalConsultas</h3>
                    <p class="text-muted">Total de Consultas</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-clock text-danger"></i>
                        Consultas Agendadas (@ViewBag.ConsultasAgendadas)
                    </h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.ConsultasAgendadas > 0)
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            Você tem <strong>@ViewBag.ConsultasAgendadas</strong> consulta(s) agendada(s) para os próximos dias.
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">Nenhuma consulta agendada no momento.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h5 class="mb-3">Acesso Rápido</h5>
            <div class="row g-3">
                <div class="col-md-3">
                    <a href="/Responsaveis" class="btn btn-outline-primary w-100 py-3">
                        <i class="fas fa-users fa-2x d-block mb-2"></i>
                        <strong>Responsáveis</strong>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Veterinarios" class="btn btn-outline-success w-100 py-3">
                        <i class="fas fa-user-md fa-2x d-block mb-2"></i>
                        <strong>Veterinários</strong>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Pets" class="btn btn-outline-warning w-100 py-3">
                        <i class="fas fa-paw fa-2x d-block mb-2"></i>
                        <strong>Pets</strong>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Consultas" class="btn btn-outline-info w-100 py-3">
                        <i class="fas fa-calendar-alt fa-2x d-block mb-2"></i>
                        <strong>Consultas</strong>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/HistoricoClinico" class="btn btn-outline-info w-100 py-3">
                        <i class="fas fa-calendar-alt fa-2x d-block mb-2"></i>
                        <strong>HistoricoClinico</strong>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .pet-card {
        transition: all 0.3s ease;
    }

        .pet-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.12) !important;
        }
</style>