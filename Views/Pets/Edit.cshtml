@model YourPetHealth.Models.Pet

@{
    ViewData["Title"] = "Novo Pet";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>🐾 @(ViewData["Title"])</h2>

    <form asp-action="@(ViewContext.RouteData.Values["Action"])" method="post" class="card p-4">
        <div class="mb-3">
            <label class="form-label">Responsável</label>
            <select asp-for="ResponsavelId" class="form-select" asp-items="ViewBag.Responsaveis">
                <option value="">Selecione um responsável...</option>
            </select>
            <span asp-validation-for="ResponsavelId" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Raca" class="form-label"></label>
                <input asp-for="Raca" class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Idade" class="form-label"></label>
                <input asp-for="Idade" type="number" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Peso" class="form-label"></label>
                <input asp-for="Peso" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Sexo" class="form-label"></label>
                <select asp-for="Sexo" class="form-select">
                    <option value="MACHO">Macho</option>
                    <option value="FEMEA">Fêmea</option>
                </select>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">Salvar Pet</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}