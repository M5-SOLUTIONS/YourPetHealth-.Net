@model IEnumerable<YourPetHealth.Models.Pet>

@{
    ViewData["Title"] = "Pets";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🐾 Meus Pets</h2>
        <a href="/Pets/Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Novo Pet
        </a>
    </div>

    <a asp-action="Index" asp-controller="Home" class="btn btn-primary navbar-btn">Voltar</a> |

    <hr />

    <div class="row">
        @foreach (var pet in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@pet.Nome</h5>
                        <p class="card-text">
                            <strong>Raça:</strong> @pet.Raca <br>
                            <strong>Idade:</strong> @pet.Idade anos
                        </p>
                        <span class="badge bg-primary">@pet.Sexo</span>
                    </div>
                    <div class="card-footer bg-white">
                        <a href="/Pets/Edit/@pet.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a href="/Pets/Delete/@pet.Id" class="btn btn-sm btn-danger">Excluir</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>